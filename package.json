{
  "name": "@ensolabs/designsystemet-svelte",
  "version": "1.23.0",
  "private": true,
  "description": "Designsystemet (designsystemet.no) for Svelte 5: a port of @digdir/designsystemet-react with the same markup, styled by @digdir/designsystemet-css and driven by @digdir/designsystemet-web.",
  "license": "MIT",
  "keywords": [
    "svelte",
    "designsystemet",
    "digdir",
    "design-system",
    "web-components"
  ],
  "homepage": "https://github.com/ensolabs/designsystemet-svelte#readme",
  "bugs": "https://github.com/ensolabs/designsystemet-svelte/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensolabs/designsystemet-svelte.git"
  },
  "type": "module",
  "sideEffects": [
    "./src/index.ts"
  ],
  "svelte": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#combobox-text": {
      "types": "./src/combobox/text.browser.ts",
      "browser": "./src/combobox/text.browser.ts",
      "default": "./src/combobox/text.server.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "typecheck": "svelte-check --tsconfig tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "test:browser": "vitest run --project browser",
    "check:version": "bun scripts/check-version.ts",
    "vendor:stories": "bun scripts/vendor-stories.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@digdir/designsystemet-css": "1.23.0",
    "svelte": "^5.29.0"
  },
  "dependencies": {
    "@digdir/designsystemet-web": "1.23.0",
    "@floating-ui/dom": "1.8.0",
    "@tanstack/virtual-core": "3.19.8"
  },
  "devDependencies": {
    "@digdir/designsystemet-css": "1.23.0",
    "@digdir/designsystemet-react": "1.23.0",
    "@navikt/aksel-icons": "8.20.1",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "21.1.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-webdriverio": "5.0.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-dropzone": "19.3.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.5",
    "webdriverio": "10.1.0"
  }
}
